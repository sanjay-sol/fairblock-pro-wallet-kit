# ============================================================================
#  Fairblock Pro backend config.  Copy to `.env` and fill in Turnkey.
#  `.env` is gitignored — NEVER commit it.  Use TEST-org keys in dev.
#  There is NO chain config here — the browser picks the testnet.
# ============================================================================

# ---- Turnkey (parent org that owns the per-treasury sub-orgs) --------------
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_ORG_ID=__your_turnkey_parent_org_id__
TURNKEY_API_PUBLIC_KEY=__your_turnkey_api_public_key__
TURNKEY_API_PRIVATE_KEY=__your_turnkey_api_private_key__

# ---- Server / passkey ------------------------------------------------------
PORT=8791
# RP_ID = the domain passkeys are bound to. "localhost" for dev; your apex
# domain (e.g. "yourdomain.com") in production. Must match the dashboard site.
RP_ID=localhost
APP_NAME=Fairblock Pro

# Optional: override the SDK's request-persistence backend. Leave EMPTY in
# production so the SDK uses its hosted default (the real Fairblock backend).
SDK_API_BASE_URL=

# Comma-separated allowed dashboard origin(s).
FRONTEND_ORIGIN=http://localhost:5175
