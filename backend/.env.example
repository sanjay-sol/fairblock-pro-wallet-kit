# ============================================================================
#  Stabletrust Pro — Model B backend config. Copy to `.env` and fill in.
#  `.env` is gitignored — NEVER commit it. Use a TEST Turnkey org in dev.
#  There is NO chain config here — the 6 supported testnets live in chains.mjs
#  (and frontend/src/networks.js). Optionally override a chain's RPC below.
# ============================================================================

# ---- Server ----------------------------------------------------------------
PORT=8792
APP_NAME=Stabletrust Pro
# Comma-separated allowed dashboard origin(s).
FRONTEND_ORIGIN=http://localhost:5176
# Base URL used in invite emails (the frontend).
APP_URL=http://localhost:5176

# ---- Database --------------------------------------------------------------
# "firestore" → Firebase (needs serviceAccount.json below). Anything else → in-memory
# (shared across browsers via this one process, but state resets on restart; good for
# local dev). Firestore free (Spark) tier caps at 50K reads/day — use Blaze for prod.
DB_BACKEND=firestore
# Firebase Admin service-account key (SECRET, gitignored). Firebase Console →
# Project settings → Service accounts → Generate new private key → save here.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# ---- Turnkey (parent org that owns the per-treasury sub-orgs) ---------------
# SECRET: TURNKEY_API_PRIVATE_KEY. The org must have signing credits (not over quota).
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_ORG_ID=__your_turnkey_parent_org_id__
TURNKEY_AUTH_PROXY_CONFIG_ID=__your_turnkey_auth_proxy_config_id__
TURNKEY_API_PUBLIC_KEY=__your_turnkey_api_public_key__
TURNKEY_API_PRIVATE_KEY=__your_turnkey_api_private_key__

# ---- Invite email (auto-detects: SendGrid → SMTP → console-log) ------------
# SECRET: SMTP_PASS (e.g. a Gmail App Password). Leave blank to log invites to console.
MAIL_FROM="Stabletrust Pro <you@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=__your_smtp_app_password__

# ---- Optional: override the SDK's request-persistence backend ---------------
# Leave EMPTY in production so the SDK uses its hosted default (the real Fairblock backend).
SDK_API_BASE_URL=

# ---- Optional: per-chain RPC overrides (defaults are in chains.mjs) ---------
# RPC_84532=https://your-base-sepolia-rpc
# RPC_11155111=https://your-eth-sepolia-rpc
